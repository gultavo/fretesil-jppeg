# Copie para .env e preencha. Nunca envie o .env para o Git.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True apenas em desenvolvimento (tambem serve as fotos enviadas)
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Origens permitidas quando DEBUG=False, separadas por virgula
CORS_ALLOWED_ORIGINS=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=fretesil
DB_USER=postgres
# Escolha uma senha propria
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Preco do litro usado quando a carga nao informa um valor proprio
PRECO_COMBUSTIVEL_PADRAO=6.00

# Publicacao da imagem no Docker Hub
DOCKERHUB_USER=seu_usuario
IMAGE_TAG=latest
